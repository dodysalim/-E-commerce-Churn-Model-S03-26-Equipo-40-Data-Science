# Copia este archivo a .env y completa los valores. No subas .env a Git.

# URL del proyecto Supabase (ej. https://<proyecto>.supabase.co)
SUPABASE_URL=

# Clave ANON (publishable). La usa el dashboard para LEER las vistas.
SUPABASE_KEY=

# Clave SERVICE_ROLE (secreta). La usa el pipeline para ESCRIBIR. Nunca al frontend.
SUPABASE_SERVICE_KEY=
